<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.getalby.mobile" />
    </queries>
    <application>
        <provider
            android:name="io.github.nogringo.dostr.NdkUpdateFileProvider"
            android:authorities="${applicationId}.ndk_updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ndk_update_paths" />
        </provider>
    </application>
</manifest>
